# ============================================================================
#  EAPEX — contoh konfigurasi. Salin jadi .env lalu isi nilainya.
#  JANGAN pernah commit berkas .env yang sudah terisi.
# ============================================================================

# Kunci tanda tangan cookie sesi. WAJIB diisi di produksi (minimal 32 karakter acak).
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Kosongkan untuk memakai SQLite lokal (data/eapex.db).
# Isi untuk memakai PostgreSQL saat deploy.
#
# SUPABASE — ambil di Project Settings > Database > Connection string.
# WAJIB pakai "Transaction pooler" (port 6543), BUKAN koneksi langsung 5432.
# Vercel membuat banyak sambungan pendek; koneksi langsung akan cepat penuh dan
# gejalanya bukan galat jelas, melainkan permintaan yang menggantung.
#
# DATABASE_URL=postgresql://postgres.xxxx:SANDI@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
#
# Jumlah sambungan per contoh fungsi. Di Vercel otomatis 2; naikkan hanya kalau
# memang perlu dan jatah pooler Supabase mencukupi.
# PG_MAX_KOLAM=2

# Port server lokal
PORT=4700

# ---------------------------------------------------------------------------
# Sesi keluar sendiri setelah sekian MENIT TANPA AKTIVITAS (bawaan 60).
# Yang dihitung diamnya, bukan lama masuknya — orang yang bekerja terus tidak
# akan terlempar keluar di tengah mengisi formulir.
# SESI_MENIT=60

# Batas MUTLAK umur satu sesi dalam jam (bawaan 12), seaktif apa pun pemakainya.
# SESI_MAKS_JAM=12

# Sandi awal akun admin saat basis data pertama kali dibuat.
# Kalau kosong, sistem membuat sandi acak dan MENAMPILKANNYA sekali di layar console.
ADMIN_EMAIL=admin@kla.co.id
ADMIN_PASSWORD=

# Batas ukuran satu lampiran (MB)
MAKS_LAMPIRAN_MB=10

# Folder singgah berkas lampiran. Kosong = data/lampiran di dalam folder aplikasi
# (di Vercel otomatis memakai folder sementara sistem).
# Pengujian (npm run cek) selalu mengarahkannya ke folder sementara sendiri.
# LAMPIRAN_DIR=

# Tempat isi lampiran disimpan:
#   disk  (bawaan) — di dalam folder di atas. Untuk komputer sendiri atau VPS.
#   db             — di dalam basis data. WAJIB untuk hosting yang cakramnya
#                    hilang tiap penyebaran (Vercel, Cloud Run). Tanpa ini,
#                    lampiran dokumen lama menguap tanpa pemberitahuan.
# SIMPANAN=disk

# Notifikasi Telegram (opsional). Kalau kosong, notifikasi hanya tampil di dalam aplikasi.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Notifikasi lewat EMAIL (opsional tapi sangat disarankan).
#
# Notifikasi HP baru sampai kalau orangnya memasang aplikasi dan mengizinkan
# notifikasi. Email tidak menuntut apa pun dari penerimanya.
#
# Alamat tujuan diisi per pengguna di Admin > Pengguna > "Email untuk notifikasi"
# dan TIDAK WAJIB — yang kosong sekadar tidak menerima email.
#
# Gmail / Google Workspace: pakai App Password, bukan sandi akun biasa.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=EAPEX <no-reply@kla.co.id>

# Alamat aplikasi yang bisa dibuka orang, dipakai untuk tautan di dalam email
# dan notifikasi. Tanpa ini emailnya tetap terkirim, hanya tanpa tombol.
# ALAMAT_APLIKASI=https://eapex.kla.co.id

# ---------------------------------------------------------------------------
# Pengingat approval harian.
#
# Server yang hidup terus (VPS) menjalankannya sendiri — tidak perlu apa-apa.
# Hosting tanpa server tetap memanggil GET/POST /api/pengingat lewat penjadwal
# platformnya (vercel.json sudah menyiapkannya untuk 10.00 WIB).
#
# Tanpa rahasia ini terisi, alamat pemicunya MATI — bukan terbuka untuk umum.
# Buat dengan:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ---------------------------------------------------------------------------
# PENGINGAT_SECRET=

# Jam kirim pengingat (0-23, waktu WIB). Bawaannya 10.
# JAM_PENGINGAT=10

# ---------------------------------------------------------------------------
# Notifikasi ke HP (Web Push). Buat kuncinya sekali dengan:  npm run kunci-push
# lalu salin hasilnya ke sini. Tanpa ini aplikasi tetap jalan, hanya notifikasi
# HP-nya mati.
#
# Syarat dari peramban, bukan dari aplikasi ini:
#   - Alamat WAJIB https (kecuali http://localhost untuk uji coba)
#   - iPhone/iPad: aplikasi harus dipasang dulu lewat Bagikan > Add to Home Screen
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@kla.co.id

# Set ke 1 kalau aplikasi berjalan di belakang proxy/HTTPS (Vercel, Nginx)
# DI_BELAKANG_PROXY=1

# ---------------------------------------------------------------------------
# Baca penawaran otomatis (OpenAI).
#
# TANPA kunci ini aplikasi tetap jalan penuh — tombol "Baca penawaran ini"
# hanya tidak muncul dan formulir diisi manual seperti biasa.
#
# SADARI: begitu diisi, ISI BERKAS PENAWARAN DIKIRIM KE OPENAI. Excel/CSV
# dikirim sebagai teks hasil uraian di server; PDF dan foto dikirim utuh.
# Harga vendor ikut keluar dari kantor. Kosongkan kalau itu tidak dikehendaki.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_DETIK=60

# ---------------------------------------------------------------------------
# Zona waktu tampilan. Bawaannya WIB (Asia/Jakarta) — waktu disimpan sebagai UTC
# dan SELALU ditampilkan dalam zona ini, apa pun zona waktu servernya.
# ---------------------------------------------------------------------------
# ZONA_WAKTU=Asia/Jakarta
# LABEL_ZONA=WIB
