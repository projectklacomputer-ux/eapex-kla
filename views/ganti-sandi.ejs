<%- include('partials/atas') %>

<div class="kartu" style="max-width:520px">
  <div class="kepala"><h2>Ganti Sandi</h2></div>
  <div class="badan">
    <% if (wajib) { %>
      <div class="pesan ingat">
        Ini login pertama Anda (atau sandi baru saja disetel ulang Administrator).
        Sandi wajib diganti dulu sebelum aplikasi bisa dipakai.
      </div>
    <% } %>
    <% if (galat) { %><div class="pesan galat">⚠ <%= galat %></div><% } %>

    <form method="post" action="/ganti-sandi">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="medan">
        <label class="f" for="sandi_lama">Sandi saat ini <span class="wajib">*</span></label>
        <input type="password" id="sandi_lama" name="sandi_lama" required autocomplete="current-password">
      </div>
      <div class="medan">
        <label class="f" for="sandi_baru">Sandi baru <span class="wajib">*</span></label>
        <input type="password" id="sandi_baru" name="sandi_baru" required autocomplete="new-password">
        <div class="petunjuk">Minimal 8 karakter, memuat huruf dan angka.</div>
      </div>
      <div class="medan">
        <label class="f" for="sandi_ulang">Ulangi sandi baru <span class="wajib">*</span></label>
        <input type="password" id="sandi_ulang" name="sandi_ulang" required autocomplete="new-password">
      </div>
      <button class="tombol utama" type="submit">Simpan Sandi Baru</button>
    </form>
  </div>
</div>

<%- include('partials/bawah') %>
